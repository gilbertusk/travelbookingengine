{
  "uid": "tbe-overview",
  "title": "Travel Booking Engine \u2014 Ikhtisar",
  "tags": ["tbe"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Latensi HTTP p95 per service",
      "description": "Sumber angka M1 dan M2 pada PRD. Ambang 800ms ditandai sebagai garis.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Latensi supplier p95",
      "description": "Per supplier dan per operasi. LUNA diharapkan jauh lebih lambat dari SKY.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, supplier) (rate(supplier_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{supplier}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Keadaan pemutus sirkuit",
      "description": "0 tertutup, 1 setengah terbuka, 2 terbuka. Nilai di atas nol berarti supplier sedang dilewati.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "supplier_circuit_state",
          "legendFormat": "{{supplier}} \u00b7 {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Rasio cache hit pencarian",
      "description": "Sumber angka M3 pada PRD. Target di atas 70 persen.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(search_cache_hits_total[5m])) / clamp_min(sum(rate(search_cache_hits_total[5m])) + sum(rate(search_cache_misses_total[5m])), 0.0001)",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Hasil langkah saga pemesanan",
      "description": "Langkah yang gagal terus-menerus menandakan kompensasi sedang sering berjalan.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (step, outcome) (rate(booking_saga_step_total[1m]))",
          "legendFormat": "{{step}} \u2014 {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Percobaan ulang ke supplier",
      "description": "Lonjakan di sini biasanya mendahului pemutus sirkuit terbuka.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (supplier) (rate(supplier_retry_total[1m]))",
          "legendFormat": "{{supplier}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    }
  ]
}
