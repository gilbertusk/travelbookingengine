# Konfigurasi infrastruktur pengembangan lokal.
# Salin menjadi infra/.env sebelum menjalankan pnpm infra:up
#
# Nilai di sini HANYA untuk pengembangan lokal. Kredensial produksi tidak pernah
# berada di berkas apa pun di dalam repo — lihat Step 30.

# --- PostgreSQL ---
POSTGRES_USER=tbe
POSTGRES_PASSWORD=tbe_local_dev
# 5433 dipakai agar tidak bentrok dengan Postgres yang sudah terpasang di mesin
POSTGRES_PORT=5433
# Satu database per service. Dibaca init-db.sh saat inisialisasi pertama.
SERVICE_DATABASES=auth,search,supplier,pricing,booking,payment,voucher,notification,analytics

# --- Redis ---
REDIS_PASSWORD=tbe_local_dev
# 6380 dipakai agar tidak bentrok dengan Redis lokal
REDIS_PORT=6380

# --- RabbitMQ ---
RABBITMQ_USER=tbe
RABBITMQ_PASSWORD=tbe_local_dev
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Kafka ---
# ID klaster tetap agar volume tidak perlu diformat ulang setiap restart
KAFKA_CLUSTER_ID=tbe-local-cluster-0001
KAFKA_PORT=29092
KAFKA_UI_PORT=8090

# --- MinIO ---
MINIO_ROOT_USER=tbe
MINIO_ROOT_PASSWORD=tbe_local_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=vouchers

# --- Jaeger ---
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
