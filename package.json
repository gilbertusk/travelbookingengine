{
  "name": "travel-booking-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:tokens": "node scripts/verify-design-tokens.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:money": "node scripts/verify-money.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "infra:up": "pnpm infra:_up && pnpm infra:_init",
    "infra:_up": "docker compose --env-file infra/.env -f infra/docker-compose.yml up -d --wait",
    "infra:_init": "docker compose --env-file infra/.env -f infra/docker-compose.yml run --rm --quiet-pull minio-init",
    "infra:down": "docker compose --env-file infra/.env -f infra/docker-compose.yml down",
    "infra:reset": "docker compose --env-file infra/.env -f infra/docker-compose.yml down -v",
    "infra:logs": "docker compose --env-file infra/.env -f infra/docker-compose.yml logs -f",
    "infra:ps": "docker compose --env-file infra/.env -f infra/docker-compose.yml ps",
    "prepare": "husky",
    "topics:create": "pnpm --filter @tbe/messaging build && pnpm --filter @tbe/messaging topics:create"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@tbe/eslint-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
