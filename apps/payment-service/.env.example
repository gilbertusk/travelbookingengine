# Salin menjadi apps/payment-service/.env sebelum menjalankan migrasi atau service.
#
# Tidak satu pun nilai di berkas ini adalah kredensial sungguhan. Kunci Midtrans
# di bawah adalah PENANDA yang wajib diganti — service menolak startup bila
# keduanya kosong, dan itu disengaja: server key kosong membuat setiap notifikasi
# yang sah ditolak sebagai tanda tangan palsu, dan gejalanya terlihat seperti
# serangan alih-alih seperti kesalahan konfigurasi.

NODE_ENV=development
SERVICE_NAME=payment-service
PORT=4007
LOG_LEVEL=debug

# Port 5433 dan 6380 mengikuti pemetaan di infra/docker-compose.yml
DATABASE_URL=postgresql://tbe:tbe_local_dev@localhost:5433/payment
REDIS_URL=redis://localhost:6380

# Redis dipakai HANYA untuk pembatasan laju webhook. Idempotensi TIDAK memakai
# Redis: ia bertumpu pada batasan UNIK di Postgres. Redis yang tumbang berarti
# pembatas laju hilang, bukan idempotensi hilang.

KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://tbe:tbe_local_dev@localhost:5673

# Kredensial sandbox Midtrans — keputusan Q1. Ambil dari dasbor sandbox, jangan
# pernah di-commit. Keduanya divalidasi saat startup.
#
# MIDTRANS_CLIENT_KEY tidak dipakai service ini; ia dibutuhkan peramban untuk
# Snap.js. Tetap divalidasi di sini supaya penyebaran yang lupa mengisinya gagal
# saat startup, bukan gagal di halaman pembayaran pengguna pertama.
MIDTRANS_SERVER_KEY=ganti-dengan-server-key-sandbox
MIDTRANS_CLIENT_KEY=ganti-dengan-client-key-sandbox

MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com

# Pembatasan laju endpoint webhook. Jauh lebih longgar daripada pembatas publik
# di api-gateway, dan harus begitu: yang memanggilnya adalah PENYEDIA, yang
# mengirim notifikasi berulang sebagai perilaku normal. Pembatas yang terlalu
# ketat menolak notifikasi yang sah, dan notifikasi sah yang ditolak berarti
# pembayaran tertinggal PENDING sampai penyedia mencoba lagi.
WEBHOOK_RATE_PER_MINUTE=600

# Kosong berarti CORS ditolak seluruhnya. Service ini tidak diakses peramban;
# endpoint webhook dipanggil server Midtrans, bukan halaman.
CORS_ORIGINS=

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
