# Salin menjadi apps/supplier-service/.env sebelum menjalankan migrasi atau service.
#
# Kredensial supplier TIDAK disimpan di basis data. Tabel `suppliers` hanya
# menyimpan nama variabelnya; nilainya dibaca dari sini. Basis data yang bocor
# tidak boleh sekaligus menjadi bocornya akses ke seluruh supplier.

NODE_ENV=development
SERVICE_NAME=supplier-service
PORT=4004
LOG_LEVEL=debug

# Port 5433 dan 6380 mengikuti pemetaan di infra/docker-compose.yml
DATABASE_URL=postgresql://tbe:tbe_local_dev@localhost:5433/supplier
REDIS_URL=redis://localhost:6380

# Keadaan pemutus sirkuit dan token bucket keluar keduanya hidup di Redis.
# Tanpa Redis, tiap instance akan belajar sendiri-sendiri bahwa supplier
# sedang tumbang — dan selama belajar itu, setiap instance masih menembak
# supplier yang sudah jelas mati.

# Satu proses mock-supplier menyajikan kelima supplier; di produksi berbeda.
SUPPLIER_BASE_URL=http://localhost:4000

KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://tbe:tbe_local_dev@localhost:5673

# Pembatasan laju KELUAR — melindungi supplier dari dibanjiri sistem kita
# sendiri (NFR-14). Arahnya berlawanan dengan pembatas di api-gateway.
SUPPLIER_RATE_PER_SECOND=20
SUPPLIER_RATE_BURST=40

# Kosong berarti CORS ditolak seluruhnya. Service ini tidak diakses peramban.
CORS_ORIGINS=

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
