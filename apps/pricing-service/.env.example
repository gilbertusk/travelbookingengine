# Salin menjadi apps/pricing-service/.env sebelum menjalankan migrasi atau service.
#
# Nilai-nilai di sini MENENTUKAN HARGA JUAL. Satu angka yang keliru di berkas
# ini tidak membuat apa pun gagal — ia hanya membuat setiap harga sedikit
# salah, dan salahnya baru ketahuan saat rekonsiliasi.

NODE_ENV=development
SERVICE_NAME=pricing-service
PORT=4005
LOG_LEVEL=debug

# Port 5433 dan 6380 mengikuti pemetaan di infra/docker-compose.yml
DATABASE_URL=postgresql://tbe:tbe_local_dev@localhost:5433/pricing
REDIS_URL=redis://localhost:6380

# Keputusan Q2: hanya IDR dan USD. Mata uang yang dilihat pengguna adalah
# rupiah; dolar hanya ada karena sebagian supplier memberi harga dalam dolar.
SELLING_CURRENCY=IDR

# Bankers' rounding. half_up membulatkan SETIAP nilai tengah ke atas, dan pada
# jutaan transaksi bias satu arah itu menumpuk menjadi selisih yang nyata.
# Pilihan lain: half_up, half_away_from_zero, up, down.
PRICE_ROUNDING=half_even

# PPN Indonesia dalam basis poin: 1100 berarti 11%.
#
# Tidak ada tabel untuk ini dengan sengaja. Tarif pajak berubah lewat
# undang-undang, bukan lewat panel operator, dan perubahannya perlu dibaca
# orang sebelum berlaku.
DEFAULT_TAX_BASIS_POINTS=1100
DEFAULT_TAX_NAME=PPN

# TTL cache kurs, dalam detik. Pendek dengan sengaja: kurs basi berarti harga
# jual yang salah, dan harga jual yang salah adalah kerugian — bukan sekadar
# tampilan yang usang.
RATE_CACHE_TTL_SECONDS=300

# Kosong berarti CORS ditolak seluruhnya. Service ini tidak diakses peramban;
# yang memanggilnya adalah search-service dan booking-service lewat jaringan
# internal, dan rute operatornya lewat api-gateway.
CORS_ORIGINS=

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
