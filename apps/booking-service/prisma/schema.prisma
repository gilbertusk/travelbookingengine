// Skema booking-service.
//
// Dua tabel: `bookings` menyimpan keadaan sekarang, `booking_events` menyimpan
// bagaimana keadaan itu tercapai. Keduanya selalu ditulis dalam SATU transaksi
// — lihat src/infrastructure/prisma-booking-repository.ts — karena keadaan
// tanpa jejaknya melanggar NFR-10, dan jejak tanpa keadaannya berbohong
// tentang apa yang pernah terjadi.
//
// Dua keputusan tipe kolom yang bukan detail kecil:
//
// - `check_in` dan `check_out` bertipe DATE, BUKAN TIMESTAMP (NFR-09,
//   CONVENTIONS.md bagian 9). Keduanya tanggal kalender lokal properti.
//   TIMESTAMP memaksa pemilihan zona saat menulis dan saat membaca, dan setiap
//   pilihan yang berbeda menggeser menginap satu hari.
// - Seluruh waktu kejadian sistem bertipe TIMESTAMPTZ.
//
// Tidak ada kolom pecahan biner. Uang disimpan sebagai bilangan bulat satuan
// terkecil (`amount_minor`) berpasangan dengan kolom mata uangnya — NFR-08,
// pola yang sama dengan payment-service.
//
// Beberapa aturan TIDAK dapat dinyatakan Prisma dan ditambahkan langsung di
// migrasi: batasan CHECK per keadaan dan trigger append-only pada
// booking_events. Lihat prisma/migrations/*_init/migration.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Sama persis dengan BOOKING_STATUSES di src/domain/booking.ts. Kesepakatan
/// keduanya diperiksa dari dua arah oleh prisma-schema.test.ts.
enum BookingStatus {
  DRAFT
  PRICE_CHECKED
  HELD
  PAID
  CONFIRMED
  CANCELLING
  FAILED
  REFUNDED
  CANCELLED
  EXPIRED
  NEEDS_REVIEW

  @@map("booking_status")
}

enum PriceCheckOutcome {
  verified
  changed
  accepted

  @@map("price_check_outcome")
}

enum CancellationReason {
  user_request
  payment_failed
  supplier_rejected

  @@map("cancellation_reason")
}

/// Jenis peristiwa domain. Sama persis dengan BOOKING_EVENT_TYPES.
enum BookingEventType {
  BookingCreated
  PriceVerified
  PriceChanged
  PriceAccepted
  BookingHeld
  HoldExpired
  PaymentRecorded
  BookingConfirmed
  BookingFailed
  BookingRefunded
  BookingCancelled
  ReviewRequired
  CancellationRequested
  SupplierCancellationConfirmed
  CancellationRestored
  CancellationCompleted

  @@map("booking_event_type")
}

/// Langkah pembatalan oleh pengguna yang sedang ditunggu (Step 25).
enum CancellationStep {
  /// supplier.cancel terkirim; kamar belum pasti lepas.
  supplier
  /// Kamar sudah lepas; payment.refund terkirim.
  refund

  @@map("cancellation_step")
}

model Booking {
  id     String        @id @db.Uuid
  userId String        @map("user_id") @db.Uuid
  status BookingStatus

  /// Kode supplier (SKY, NOVA, ...), bukan UUID — supplier adalah himpunan
  /// tetap yang dinamai, dan kode itulah yang dibawa kontrak peristiwa.
  supplierId  String @map("supplier_id")
  propertyId  String @map("property_id")
  /// Kota properti — cakupan aturan markup di pricing-service. Ditambahkan
  /// Step 17, lewat migrasi kedua.
  city        String
  ratePlanRef String @map("rate_plan_ref")

  /// Ketentuan tawaran yang dipesan — jenis kamar, rate plan, sarapan,
  /// kebijakan pembatalan — disalin saat price check sebagai bahan e-voucher
  /// (Step 23). Objek JSON dengan satu kunci `terms`, berisi ketentuannya atau
  /// null — pola yang sama dengan `price_lines`, supaya kolomnya tidak pernah
  /// null di tingkat SQL. `terms` null hanya untuk pemesanan sebelum Step 23.
  /// Tidak berubah setelah pemesanan dibuat. (Tanpa kurung kurawal di komentar
  /// ini: prisma-schema.test.ts membaca blok model sampai kurung tutup pertama.)
  offerTerms Json @map("offer_terms")

  /// Jadwal pengembalian saat pembatalan (Step 25), dari kebijakan yang
  /// dijawab SUPPLIER saat price check. Objek JSON dengan satu kunci `tiers`,
  /// berisi daftar jenjang atau null — null untuk pemesanan yang belum pernah
  /// diverifikasi harganya, dan untuk pemesanan sebelum Step 25.
  refundSchedule Json @map("refund_schedule")

  /// Tanggal lokal properti. DATE, bukan TIMESTAMP — lihat kepala berkas.
  checkIn  DateTime @map("check_in") @db.Date
  checkOut DateTime @map("check_out") @db.Date

  /// Jumlah tamu. Nama dan surel tamu utama di dua kolom berikutnya.
  guests         Int
  leadGuestName  String @map("lead_guest_name")
  leadGuestEmail String @map("lead_guest_email")

  /// Harga yang TERAKHIR disetujui pengguna, satu-satunya nilai yang boleh
  /// ditagih (G2). Disimpan sebagai kolom skalar supaya dapat dikueri dan
  /// dibandingkan tanpa mengurai JSON; rinciannya ada di `price_lines`.
  amountMinor Int    @map("amount_minor")
  currency    String

  /// Hasil price check terakhir. Hanya ada pada PRICE_CHECKED.
  priceCheck PriceCheckOutcome? @map("price_check")

  /// Total harga baru yang menunggu persetujuan. Hanya ada saat
  /// `price_check` = `changed`.
  quotedAmountMinor Int?    @map("quoted_amount_minor")
  quotedCurrency    String? @map("quoted_currency")

  /// Rincian harga: `{ "agreed": [...], "quoted": [...] | null }`.
  ///
  /// SATU kolom JSON yang tidak pernah null, bukan dua kolom yang salah satunya
  /// nullable. Kolom `Json?` di Prisma tidak menerima `null` biasa — ia menuntut
  /// sentinel `Prisma.DbNull` dari klien tergenerate — sehingga port
  /// repository tidak lagi dapat dipenuhi palsuan di memori dan klien sungguhan
  /// dengan tipe yang sama. Null di DALAM JSON tidak punya masalah itu.
  priceLines Json @map("price_lines")

  /// Token hold dari supplier. Ada pada HELD dan EXPIRED — pelepasan hold di
  /// supplier membutuhkannya setelah keadaan berpindah.
  holdRef   String?   @map("hold_ref")
  /// Yang lebih awal antara kedaluwarsa lokal dan kedaluwarsa supplier.
  /// Dibaca penyapu hold Step 17.
  heldUntil DateTime? @map("held_until") @db.Timestamptz(3)

  paymentId String? @map("payment_id") @db.Uuid

  /// Booking reference dari supplier — bukti pemesanan yang sah (FR-24).
  /// Wajib pada CONFIRMED, dan batasan CHECK di migrasi menegakkannya.
  supplierRef String? @map("supplier_ref")

  refundId      String?             @map("refund_id") @db.Uuid
  failureReason String?             @map("failure_reason")
  cancellation  CancellationReason?
  reviewReason  String?             @map("review_reason")
  /// Keadaan asal peninjauan: PAID, FAILED, atau CANCELLING.
  reviewFrom    BookingStatus?      @map("review_from")

  /// Pembatalan oleh pengguna (Step 25). Empat kolom pertama adalah
  /// persetujuannya — nilai, persentase, dan waktu permintaan — dan tetap ada
  /// pada CANCELLED sesudahnya. Dua kolom terakhir adalah langkah yang sedang
  /// ditunggu, dan hanya ada selama CANCELLING. Batasan CHECK di migrasi
  /// menegakkan keduanya.
  cancelRefundMinor    Int?              @map("cancel_refund_minor")
  cancelRefundCurrency String?           @map("cancel_refund_currency")
  cancelRefundPercent  Int?              @map("cancel_refund_percent")
  cancelRequestedAt    DateTime?         @map("cancel_requested_at") @db.Timestamptz(3)
  cancelStep           CancellationStep? @map("cancel_step")
  /// Batas menunggu jawaban supplier atau refund. Dibaca penyapu pembatalan.
  cancelDeadlineAt     DateTime?         @map("cancel_deadline_at") @db.Timestamptz(3)

  /// Kunci idempotensi dari klien (FR-18). Unik BERSAMA user_id — lihat
  /// @@unique di bawah.
  idempotencyKey String @map("idempotency_key")

  /// Kunci optimistik. Penyimpanan transisi hanya berhasil bila versi yang
  /// tersimpan masih versi sebelum transisi.
  version Int

  /// Waktu kejadian, dari domain — bukan @updatedAt. Waktu ubah adalah waktu
  /// transisi terjadi, bukan waktu baris kebetulan ditulis.
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  events BookingEvent[]
  saga   SagaState?
  outbox OutboxMessage[]

  /// Keunikan kunci idempotensi per PENGGUNA, bukan global. Kunci dikirim
  /// klien; dengan keunikan global, dua pengguna yang kebetulan — atau sengaja
  /// — mengirim kunci yang sama membuat pengguna kedua menerima pemesanan
  /// pengguna pertama. Indeks ini juga melayani pencarian menurut user_id,
  /// karena user_id kolom terdepannya.
  @@unique([userId, idempotencyKey])
  /// Penyapu hold Step 17: `status = 'HELD' AND held_until < now()`. Satu indeks
  /// gabungan melayani kueri itu dan kueri menurut status saja.
  @@index([status, heldUntil])
  /// Penyapu pembatalan Step 25: `status = 'CANCELLING' AND cancel_deadline_at < now()`.
  @@index([status, cancelDeadlineAt])
  /// Daftar pemesanan pengguna (Step 26): selalu menurut pemiliknya, diurutkan
  /// menurut tanggal masuk untuk kelompok "akan datang" dan "selesai".
  @@index([userId, checkIn])
  @@map("bookings")
}

/// Jejak audit. HANYA BERTAMBAH (NFR-10).
///
/// Tidak ada operasi ubah atau hapus di port repository, dan trigger di
/// migrasi menolak UPDATE dan DELETE pada tingkat basis data — termasuk dari
/// psql, dari skrip perbaikan data, dan dari kode yang belum ditulis.
model BookingEvent {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid

  /// Versi pemesanan SETELAH transisi. Unik per pemesanan: dua penulis yang
  /// sama-sama mengira menang tidak dapat sama-sama tercatat, dan urutan jejak
  /// tidak bergantung pada jam mesin mana pun.
  sequence Int

  eventType  BookingEventType @map("event_type")
  payload    Json
  occurredAt DateTime         @map("occurred_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([bookingId, sequence])
  @@map("booking_events")
}

// ---------------------------------------------------------------------------
// Step 19: saga, outbox, dan catatan pesan yang sudah dikonsumsi.
//
// Ketiganya ditulis dalam transaksi yang SAMA dengan bookings dan
// booking_events bila perubahan keadaan menyertainya. Itulah seluruh alasan
// ketiganya tinggal di basis data ini, bukan di Redis atau di broker: transaksi
// tidak dapat melintasi dua sistem penyimpanan.
// ---------------------------------------------------------------------------

/// Sama persis dengan SAGA_STEPS di src/domain/saga-definition.ts.
enum SagaStep {
  priceCheck
  holdLocal
  holdSupplier
  awaitPayment
  confirmSupplier
  issueVoucher

  @@map("saga_step")
}

enum SagaStepStatus {
  /// Langkah langsung sedang dikerjakan — dicatat SEBELUM dikerjakan.
  started
  /// Perintahnya sudah di outbox; menunggu jawaban.
  waiting
  succeeded
  failed

  @@map("saga_step_status")
}

enum CompensationStatus {
  none
  running
  completed
  failed

  @@map("compensation_status")
}

/// Keadaan saga satu pemesanan (Step 19). Satu baris per pemesanan.
///
/// Kolom step doc (currentStep, stepStatus, compensationStatus, attempts,
/// lastError, updatedAt) ditambah empat yang dibutuhkan pemulihan:
/// `compensating_step` (kompensasi langsung berikutnya), `deadline_at` (batas
/// menunggu jawaban), `leased_until` (sewa proses yang sedang menjalankan
/// langkah langsung), dan `version` (kunci optimistik).
model SagaState {
  id        String @id @db.Uuid
  bookingId String @unique @map("booking_id") @db.Uuid

  currentStep        SagaStep           @map("current_step")
  stepStatus         SagaStepStatus     @map("step_status")
  compensationStatus CompensationStatus @map("compensation_status")
  compensatingStep   SagaStep?          @map("compensating_step")

  attempts  Int
  lastError String? @map("last_error")

  /// Batas menunggu jawaban (supplier, refund). Dicari penyapu saga.
  deadlineAt  DateTime? @map("deadline_at") @db.Timestamptz(3)
  /// Sewa proses yang menjalankan langkah langsung. Lewat berarti proses itu
  /// mati di tengah langkah, dan pemulihan mengambil alih.
  leasedUntil DateTime? @map("leased_until") @db.Timestamptz(3)

  version   Int
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([deadlineAt])
  @@index([leasedUntil])
  @@map("saga_states")
}

enum OutboxChannel {
  /// Peristiwa — fakta, ke Kafka.
  kafka
  /// Perintah — pekerjaan untuk satu pihak, ke RabbitMQ.
  rabbitmq

  @@map("outbox_channel")
}

/// Outbox (Step 19). Pesan yang HARUS terbit karena keadaan sudah berubah.
///
/// Ditulis dalam transaksi yang sama dengan perubahan keadaan; diterbitkan
/// belakangan oleh penerbit terpisah, minimal sekali. `id` adalah eventId
/// pesannya — sama pada setiap pengiriman ulang, supaya consumer dapat
/// mengenali duplikatnya.
model OutboxMessage {
  id        String @id @db.Uuid
  /// Urutan penerbitan. Per pemesanan, urutan ini sama dengan urutan commit:
  /// transaksi yang mengubah pemesanan yang sama diserialkan kunci barisnya.
  sequence  BigInt @unique @default(autoincrement())
  bookingId String @map("booking_id") @db.Uuid

  channel     OutboxChannel
  messageType String        @map("message_type")
  payload     Json

  correlationId String   @map("correlation_id")
  causationId   String?  @map("causation_id") @db.Uuid
  traceparent   String?
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  /// Pesan yang ditolak kontraknya saat diterbitkan. Tidak dicoba lagi —
  /// tidak akan pernah lolos — dan tidak menahan pesan di belakangnya.
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  /// Penerbit membaca `published_at IS NULL ORDER BY sequence`. Tanpa indeks
  /// ini, setiap putaran melompati seluruh pesan yang sudah terbit — yang
  /// jumlahnya hanya bertambah.
  @@index([publishedAt, sequence])
  @@map("outbox")
}

/// Pesan Kafka yang sudah dikonsumsi (Step 19), dicatat dalam transaksi yang
/// sama dengan efeknya. Pesan yang sama tiba dua kali — Kafka menjamin minimal
/// sekali, bukan tepat sekali — ditolak kunci primer ini, dan efeknya ikut
/// batal.
model ConsumedMessage {
  eventId    String   @id @map("event_id") @db.Uuid
  eventType  String   @map("event_type")
  bookingId  String   @map("booking_id") @db.Uuid
  consumedAt DateTime @map("consumed_at") @db.Timestamptz(3)

  @@map("consumed_messages")
}
