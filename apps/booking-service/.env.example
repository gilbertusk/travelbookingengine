# Salin menjadi apps/booking-service/.env sebelum menjalankan migrasi.
#
# Tidak satu pun nilai di berkas ini adalah kredensial sungguhan. Kata sandi di
# DATABASE_URL adalah kata sandi pengembangan lokal dari infra/.env.example.
#
# Step 16 domain murni: service ini belum punya proses yang berjalan, jadi yang
# benar-benar dibaca sekarang hanya DATABASE_URL — oleh prisma.config.ts saat
# migrasi. Tidak ada REDIS_URL, KAFKA_BROKERS, maupun RABBITMQ_URL; ketiganya
# ditambahkan oleh step yang pertama memakainya (17 dan 19), bersama skemanya
# di src/config.ts.

NODE_ENV=development
SERVICE_NAME=booking-service
PORT=4006
LOG_LEVEL=debug

# Port 5433 mengikuti pemetaan di infra/docker-compose.yml. Database `booking`
# dibuat infra/init-db.sh dari SERVICE_DATABASES.
DATABASE_URL=postgresql://tbe:tbe_local_dev@localhost:5433/booking
