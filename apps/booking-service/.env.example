# Salin menjadi apps/booking-service/.env sebelum menjalankan migrasi atau service.
#
# Tidak satu pun nilai di berkas ini adalah kredensial sungguhan. Kata sandi di
# bawah adalah kata sandi pengembangan lokal dari infra/.env.example.

NODE_ENV=development
SERVICE_NAME=booking-service
PORT=4006
LOG_LEVEL=debug

# Port 5433 dan 6380 mengikuti pemetaan di infra/docker-compose.yml. Database
# `booking` dibuat infra/init-db.sh dari SERVICE_DATABASES.
DATABASE_URL=postgresql://tbe:tbe_local_dev@localhost:5433/booking

# Hold lokal (Step 17). Redis di infra sudah berjalan dengan
# --notify-keyspace-events Ex; tanpa flag itu hold hanya dilepas penyapu, dan
# service mencatat peringatan saat startup.
REDIS_URL=redis://:tbe_local_dev@localhost:6380
REDIS_DB=0

SUPPLIER_SERVICE_URL=http://localhost:4004
PRICING_SERVICE_URL=http://localhost:4005
UPSTREAM_TIMEOUT_MS=5000

# Lima belas menit hold lokal. Batas waktu yang dipakai adalah yang lebih awal
# antara ini dan kedaluwarsa hold supplier.
HOLD_DURATION_MS=900000
# Selang penyapu: batas atas keterlambatan pelepasan bila keyspace notification
# hilang.
HOLD_SWEEP_INTERVAL_MS=30000
HOLD_SWEEP_BATCH=100

# --- Saga dan outbox (Step 19) ---
# Pendengar luar Kafka di infra. Topik dibuat `pnpm topics:create`; pembuatan
# otomatis oleh broker dimatikan.
KAFKA_BROKERS=localhost:29092
KAFKA_CONSUMER_GROUP=booking-service.saga
# Tanpa nilai bawaan di config.ts: URL-nya membawa kredensial. Kata sandi di
# bawah adalah kata sandi pengembangan lokal dari infra/.env.example.
RABBITMQ_URL=amqp://tbe:tbe_local_dev@localhost:5672

# Sewa proses untuk langkah langsung saga (hold lokal, hold supplier, pelepasan
# hold). Wajib lebih dari tiga kali UPSTREAM_TIMEOUT_MS — config.ts menolaknya.
SAGA_STEP_LEASE_MS=60000
# Batas menunggu jawaban supplier.confirm dan konfirmasi refund. Wajib lebih
# lama dari jenjang percobaan perintah RabbitMQ (5 + 30 + 120 detik).
SAGA_CONFIRM_TIMEOUT_MS=900000
SAGA_REFUND_TIMEOUT_MS=900000
SAGA_COMPENSATION_MAX_ATTEMPTS=5
SAGA_COMPENSATION_RETRY_MS=30000
SAGA_SWEEP_INTERVAL_MS=10000
SAGA_SWEEP_BATCH=100

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH=100
OUTBOX_TX_TIMEOUT_MS=30000

# Aliran SSE /bookings/stream/:id
STATUS_STREAM_POLL_MS=1000
STATUS_STREAM_HEARTBEAT_MS=15000

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Uji integrasi (pnpm test:integration) TIDAK membaca berkas ini. Ia membaca
# INTEGRATION_DATABASE_URL, INTEGRATION_REDIS_URL, INTEGRATION_KAFKA_BROKERS,
# dan INTEGRATION_RABBITMQ_URL dari env, dan gagal keras bila salah satunya
# tidak ada. Basis data uji DIBANGUN ULANG dari migrasi setiap
# kali — jangan arahkan ke basis data yang isinya ingin dipertahankan.
