# Salin menjadi apps/voucher-service/.env sebelum menjalankan migrasi atau service.
#
# Tidak satu pun nilai di berkas ini adalah kredensial sungguhan — nilai MinIO
# di bawah sama dengan infra/.env.example, hanya untuk pengembangan lokal.

NODE_ENV=development
SERVICE_NAME=voucher-service
PORT=4008
LOG_LEVEL=debug

# Port 5433 mengikuti pemetaan di infra/docker-compose.yml. Basis data
# `voucher` dibuat init-db.sh bersama basis data service lain.
DATABASE_URL=postgresql://tbe:tbe_local_dev@localhost:5433/voucher

KAFKA_BROKERS=localhost:29092
RABBITMQ_URL=amqp://tbe:tbe_local_dev@localhost:5672

# Bahan voucher: data pemesanan dari booking-service, data properti dari
# katalog search-service. Keduanya lewat rute /internal yang tidak dirutekan
# api-gateway.
BOOKING_SERVICE_URL=http://localhost:4006
SEARCH_SERVICE_URL=http://localhost:4003
UPSTREAM_TIMEOUT_MS=3000

# MINIO_URL dipakai service untuk menulis. MINIO_PUBLIC_URL adalah alamat yang
# dibuka peramban; URL unduhan ditandatangani untuk alamat itu. Di lokal
# keduanya sama, jadi MINIO_PUBLIC_URL boleh dikosongkan.
MINIO_URL=http://localhost:9000
MINIO_PUBLIC_URL=
MINIO_ACCESS_KEY=tbe
MINIO_SECRET_KEY=tbe_local_dev
MINIO_BUCKET=vouchers

VOUCHER_PREFETCH=4

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
