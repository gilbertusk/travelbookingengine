# Salin menjadi apps/search-service/.env sebelum menjalankan migrasi atau service.
#
# Service ini memiliki katalog properti: data STATIS milik sistem kita sendiri.
# Harga dan ketersediaan TIDAK PERNAH disimpan di sini — keduanya milik
# supplier dan bersumber dari supplier pada setiap pencarian.

NODE_ENV=development
SERVICE_NAME=search-service
PORT=4003
LOG_LEVEL=debug

# Port 5433 dan 6380 mengikuti pemetaan di infra/docker-compose.yml
DATABASE_URL=postgresql://tbe:tbe_local_dev@localhost:5433/search
REDIS_URL=redis://localhost:6380

# Seberapa sering katalog di memori disegarkan dari Redis, dalam detik.
#
# Boleh panjang, dan sengaja panjang. Katalog adalah data statis: nama, alamat,
# koordinat, zona waktu. Yang tidak boleh basi adalah harga, dan harga tidak
# pernah masuk ke katalog.
#
# Pemetaan manual operator TIDAK menunggu selang ini — ia membuang salinan di
# Redis seketika, supaya operator melihat hasil kerjanya.
CATALOG_REFRESH_SECONDS=300

# TTL salinan katalog di Redis. Lebih panjang dari selang penyegaran, supaya
# salinannya tidak pernah kedaluwarsa tepat di antara dua denyut.
CATALOG_CACHE_TTL_SECONDS=3600

# Seberapa sering kemunculan properti belum terpetakan disiram ke basis data.
#
# Pencatatan tidak pernah ditunggu permintaan pencarian: kemunculan dikumpulkan
# di memori lalu ditulis sekaligus. Satu penulisan basis data pada jalur kritis
# untuk sesuatu yang tidak mengubah jawaban adalah penulisan yang tidak perlu.
UNMAPPED_FLUSH_SECONDS=30

# TTL cache saran autocomplete. Kotak pencarian menghasilkan kueri yang sangat
# berulang; katalognya jarang berubah.
SUGGESTION_CACHE_TTL_SECONDS=600

# --- Pencarian (Step 13) ---

# Anggaran waktu total fan-out ke seluruh supplier, dalam milidetik.
#
# Titik awal, bukan hasil pengukuran. LUNA menjawab sekitar 3 detik; anggaran
# ini memastikan pencarian tidak pernah menunggunya — dan jawabannya TETAP
# dipanen ke cache lapis kedua untuk pencarian berikutnya. Step 15 yang
# menyetelnya berdasarkan uji beban.
SEARCH_BUDGET_MS=1200

# Batas waktu per panggilan, lebih PANJANG dari anggaran dengan sengaja.
# Yang memutuskan kapan berhenti menunggu adalah anggaran; panggilan yang
# berlanjut setelahnya justru yang hasilnya dipanen.
SUPPLIER_TIMEOUT_MS=5000
PRICING_TIMEOUT_MS=3000

SUPPLIER_SERVICE_URL=http://localhost:4004
PRICING_SERVICE_URL=http://localhost:4005

# TTL cache hasil gabungan, dalam detik. Pendek: harga berubah, dan harga
# basi yang ditampilkan lalu ditolak saat pembayaran adalah kegagalan produk
# yang paling merusak kepercayaan.
SEARCH_RESULT_TTL_SECONDS=300

# TTL cache per supplier. Sedikit lebih panjang — inilah yang membuat jawaban
# supplier lambat tetap berguna, dan yang membuat pemulihan satu supplier
# tidak membatalkan seluruh cache.
SEARCH_SUPPLIER_TTL_SECONDS=600

# Masa berlaku kunci anti-stampede. Cukup untuk satu fan-out, tidak lebih:
# kunci tanpa masa berlaku yang pemegangnya mati akan memblokir kota yang
# paling banyak dicari selamanya.
SEARCH_LOCK_TTL_SECONDS=10

KAFKA_BROKERS=localhost:9092

# Dipakai skrip seed untuk membaca kebenaran dasar katalog.
# Tidak dibaca service saat berjalan.
MOCK_SUPPLIER_URL=http://localhost:4000

# Kosong berarti CORS ditolak seluruhnya. Peramban mengakses service ini lewat
# api-gateway, bukan langsung.
CORS_ORIGINS=

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
