# Salin menjadi apps/notification-service/.env sebelum menjalankan migrasi atau service.
#
# Tidak satu pun nilai di berkas ini adalah kredensial sungguhan — hanya untuk
# pengembangan lokal, sama dengan infra/.env.example.

NODE_ENV=development
SERVICE_NAME=notification-service
PORT=4009
LOG_LEVEL=debug

# Port 5433 mengikuti pemetaan di infra/docker-compose.yml. Basis data
# `notification` dibuat init-db.sh bersama basis data service lain.
DATABASE_URL=postgresql://tbe:tbe_local_dev@localhost:5433/notification

KAFKA_BROKERS=localhost:29092
KAFKA_GROUP_ID=notification-service
RABBITMQ_URL=amqp://tbe:tbe_local_dev@localhost:5672

# Bahan surel: data pemesanan dan alamat tamu dari booking-service, berkas
# voucher dari voucher-service. Keduanya lewat rute /internal yang tidak
# dirutekan api-gateway.
BOOKING_SERVICE_URL=http://localhost:4006
VOUCHER_SERVICE_URL=http://localhost:4008
UPSTREAM_TIMEOUT_MS=3000

# Mailpit dari infra/docker-compose.yml. Surel terlihat di http://localhost:8025.
# Kosongkan SMTP_USER dan SMTP_PASSWORD untuk server tanpa autentikasi.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=10000
MAIL_FROM=Lintang <bantuan@lintang.local>

DELIVERY_INTERVAL_MS=1000
DELIVERY_BATCH_SIZE=20
DELIVERY_LEASE_MS=60000
RATE_LIMIT_PER_HOUR=10
# Rahasia HMAC kunci penerima. Nilai ini hanya untuk lokal; ganti di lingkungan lain.
RECIPIENT_KEY_SECRET=lokal-saja-bukan-rahasia-ganti-di-produksi
MAX_EVENT_AGE_HOURS=48
NOTIFICATION_PREFETCH=8

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
