# Salin menjadi apps/api-gateway/.env sebelum menjalankan gateway.
#
# Tidak ada satu pun nilai di sini yang boleh dipakai di luar pengembangan
# lokal.

NODE_ENV=development
SERVICE_NAME=api-gateway
PORT=4001
LOG_LEVEL=debug

# HARUS sama persis dengan JWT_SECRET di apps/auth-service/.env.
#
# HS256 memakai kunci simetris: penerbit dan pemverifikasi memegang nilai yang
# sama. Kalau keduanya berbeda, setiap token yang sah akan ditolak gateway dan
# gejalanya muncul sebagai 401 yang membingungkan, bukan sebagai galat
# konfigurasi. Beralih ke RS256 akan menghapus duplikasi ini — layak
# dipertimbangkan sebelum produksi.
JWT_SECRET=rahasia-pengembangan-lokal-minimal-32-karakter
JWT_ISSUER=tbe-auth
JWT_AUDIENCE=tbe-api

# Penyimpanan batas laju. Harus Redis, bukan memori proses: sepuluh replika
# gateway dengan pembatas dalam memori mengizinkan sepuluh kali kuota.
# Port 6380 mengikuti pemetaan di infra/docker-compose.yml
REDIS_URL=redis://localhost:6380

# Alamat service hulu. Seluruhnya punya bawaan localhost, jadi baris-baris ini
# hanya perlu diisi saat menjalankan gateway di luar mesin pengembangan.
AUTH_SERVICE_URL=http://localhost:4002
SEARCH_SERVICE_URL=http://localhost:4003
PRICING_SERVICE_URL=http://localhost:4005
BOOKING_SERVICE_URL=http://localhost:4006
PAYMENT_SERVICE_URL=http://localhost:4007
VOUCHER_SERVICE_URL=http://localhost:4008
ANALYTICS_SERVICE_URL=http://localhost:4010

# Berbeda dengan service lain, gateway MEMANG diakses langsung dari peramban —
# ia satu-satunya yang diakses begitu. Daftar ini harus eksplisit; kosong
# berarti seluruh asal ditolak.
CORS_ORIGINS=http://localhost:3000

# Batas ukuran badan permintaan. Gateway tidak mengurai badan, hanya membatasi
# ukurannya sebelum diteruskan.
BODY_LIMIT=1mb

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
