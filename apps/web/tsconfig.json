{
  "extends": "@tbe/tsconfig/react.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "*.config.ts",
    "*.config.mts"
  ],
  "exclude": ["node_modules", ".next"]
}
