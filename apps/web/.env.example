# Salin menjadi apps/web/.env.local sebelum menjalankan aplikasi.
#
# Hanya variabel berawalan NEXT_PUBLIC_ yang ikut ke peramban. Perlakukan
# nilainya sebagai publik: apa pun yang ditulis di sana dapat dibaca siapa pun
# yang membuka halaman.

# Alamat api-gateway dari peramban.
NEXT_PUBLIC_API_URL=http://localhost:4001

NEXT_PUBLIC_APP_NAME=Lintang

# Alamat bantuan untuk pemesanan yang sedang diperiksa manual (Step 26).
NEXT_PUBLIC_SUPPORT_EMAIL=bantuan@lintang.example

# Popup pembayaran Snap (Step 21). Client key Midtrans memang publik; kunci
# server TIDAK PERNAH ditulis di sini — ia milik payment-service. Kosongkan
# untuk memakai halaman Snap penuh alih-alih popup. Untuk mode itu, atur
# "Finish URL" di dasbor Midtrans ke http://localhost:3000/bookings/kembali.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# Alamat gateway dari sisi server. Dipisahkan karena di lingkungan terkontainer
# keduanya berbeda: peramban memanggil nama host publik, server memanggil nama
# service di jaringan internal. Kosongkan saat menjalankan semuanya di mesin
# yang sama.
API_URL=http://localhost:4001
