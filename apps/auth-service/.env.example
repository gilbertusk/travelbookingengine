# Salin menjadi apps/auth-service/.env sebelum menjalankan migrasi atau service.
#
# Tidak ada satu pun nilai di sini yang boleh dipakai di luar pengembangan
# lokal. JWT_SECRET khususnya: service yang menyala dengan rahasia dari berkas
# contoh adalah service yang tokennya dapat dipalsukan siapa pun yang pernah
# membaca repositori ini.

NODE_ENV=development
SERVICE_NAME=auth-service
PORT=4002
LOG_LEVEL=debug

# Port 5433 mengikuti pemetaan di infra/docker-compose.yml
DATABASE_URL=postgresql://tbe:tbe_local_dev@localhost:5433/auth

# Minimal 32 karakter — HS256 memakai HMAC-SHA256, jadi rahasia yang lebih
# pendek memberi entropi kurang dari keluaran algoritmanya sendiri.
JWT_SECRET=rahasia-pengembangan-lokal-minimal-32-karakter
JWT_ISSUER=tbe-auth
JWT_AUDIENCE=tbe-api

# Access token pendek karena tidak dapat dicabut; pencabutan terjadi pada
# refresh token, yang disimpan dan dapat dimatikan kapan saja.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

LOGIN_MAX_FAILURES=8
LOGIN_FAILURE_WINDOW_MINUTES=15

# Kosong berarti CORS ditolak seluruhnya. Diisi hanya bila service diakses
# langsung dari peramban — biasanya tidak, karena akses lewat api-gateway.
CORS_ORIGINS=

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
